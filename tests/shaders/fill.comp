#version 450
#extension GL_EXT_buffer_reference : require
// Writes through a raw GPU address, the way NVN shaders reach their buffers.
layout(buffer_reference, std430) buffer Out { uint v[]; };
layout(push_constant) uniform PC { Out dst; uint n; } pc;
layout(local_size_x = 64) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) pc.dst.v[i] = i * 3u + 7u;
}
