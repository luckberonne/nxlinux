#version 450
// Stand-in for the last program of the title's video enhancement (Movie/Ndve, key a22eb9ecf134873b). The real one adds the network's output to the picture and writes the 2560x1440 result;
// the network is not run (its tensor-core programs are skipped), so this one upscales the decoded picture the first program converted (texture slot 1, 1920x1080) into the output image (image slot 1).
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 1) uniform sampler2D src;
layout(binding = 2) uniform writeonly image2D dst;

void main() {
    ivec2 size = imageSize(dst);
    uvec2 total = gl_NumWorkGroups.xy * gl_WorkGroupSize.xy;
    for (uint y = gl_GlobalInvocationID.y; y < uint(size.y); y += total.y)
        for (uint x = gl_GlobalInvocationID.x; x < uint(size.x); x += total.x) {
            vec2 uv = (vec2(x, y) + 0.5) / vec2(size);
            imageStore(dst, ivec2(x, y), vec4(textureLod(src, uv, 0.0).rgb, 1.0));
        }
}
